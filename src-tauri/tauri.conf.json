{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WrionFlashTool",
  "version": "2.0.0",
  "identifier": "com.wrion.flashtool",
  "build": {
    "beforeDevCommand": "pnpm --prefix ../frontend dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wrion FlashTool",
        "width": 980,
        "height": 660,
        "minWidth": 880,
        "minHeight": 580,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
